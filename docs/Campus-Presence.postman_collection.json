                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/absences/{{absenceId}}/justification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "absences", "{{absenceId}}", "justification"]
            }
          }
        }
